{
  "name": "medusa-plugin-wishlist",
  "version": "0.0.2",
  "description": "A starter for Medusa plugins.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "main": ".medusa/server/src/index.js",
  "files": [
    ".medusa",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa-v2"
  ],
  "scripts": {
    "clean": "rm -rf .medusa",
    "build": "npm run clean && npx medusa plugin:build && npx tsc --project tsconfig.json && cp src/modules/wishlist/package.json .medusa/server/src/modules/wishlist/ 2>/dev/null || true",
    "prepublishOnly": "npm run build",
    "dev": "npx medusa plugin:develop"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.4",
    "@medusajs/cli": "^2.12.4",
    "@medusajs/framework": "^2.12.4",
    "@medusajs/icons": "^2.12.4",
    "@medusajs/medusa": "^2.12.4",
    "@medusajs/test-utils": "^2.12.4",
    "@medusajs/ui": "^4.0.25"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "yalcSig": "86775c5ba56aabed4b2107c00948e6d4"
}
